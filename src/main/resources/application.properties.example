# 应用基本配置
spring.application.name=xhs-ai-publisher
server.port=8181

# 数据库配置
spring.datasource.url=jdbc:mysql://127.0.0.1:3366/xhs_ai_publisher?useUnicode=true&characterEncoding=utf-8&sslMode=DISABLED&serverTimezone=Asia/Shanghai
spring.datasource.username=root
spring.datasource.password=your_db_password_here
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver

# JPA配置
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=true
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.MySQLDialect
spring.jpa.open-in-view=false

# Flyway数据库迁移配置
spring.flyway.enabled=true
spring.flyway.baseline-on-migrate=true
spring.flyway.locations=classpath:db/migration
spring.flyway.encoding=UTF-8
spring.flyway.table=flyway_schema_history

# Redis缓存配置
spring.data.redis.host=127.0.0.1
spring.data.redis.port=6379
spring.data.redis.password=your_redis_password_here
spring.data.redis.database=0
spring.data.redis.timeout=3000
spring.data.redis.lettuce.pool.max-active=8
spring.data.redis.lettuce.pool.max-idle=8
spring.data.redis.lettuce.pool.min-idle=0
spring.data.redis.lettuce.pool.max-wait=-1ms

# Spring Cache配置
spring.cache.type=redis
spring.cache.redis.time-to-live=600000
spring.cache.redis.cache-null-values=false
spring.cache.redis.key-prefix=xhs_cache:
spring.cache.redis.use-key-prefix=true

# Caffeine本地缓存配置
spring.cache.cache-names=hotData,userInfo,templates
spring.cache.caffeine.spec=maximumSize=1000,expireAfterWrite=5m

# 日志配置
logging.level.com.xhs=INFO
logging.level.org.springframework.security=DEBUG

# 浏览器自动化配置
playwright.headless=false
playwright.timeout=30000

# Quartz配置
spring.quartz.job-store-type=jdbc
spring.quartz.jdbc.initialize-schema=never
spring.quartz.properties.org.quartz.scheduler.instanceName=XhsPublisherScheduler
spring.quartz.properties.org.quartz.scheduler.instanceId=AUTO
spring.quartz.properties.org.quartz.jobStore.class=org.quartz.impl.jdbcjobstore.JobStoreTX
spring.quartz.properties.org.quartz.jobStore.driverDelegateClass=org.quartz.impl.jdbcjobstore.StdJDBCDelegate
spring.quartz.properties.org.quartz.jobStore.dataSource=quartzDataSource
spring.quartz.properties.org.quartz.jobStore.isClustered=true
spring.quartz.properties.org.quartz.jobStore.clusterCheckinInterval=20000
spring.quartz.properties.org.quartz.threadPool.class=org.quartz.simpl.SimpleThreadPool
spring.quartz.properties.org.quartz.threadPool.threadCount=10
spring.quartz.properties.org.quartz.dataSource.quartzDataSource.driver=com.mysql.cj.jdbc.Driver
spring.quartz.properties.org.quartz.dataSource.quartzDataSource.URL=jdbc:mysql://127.0.0.1:3366/xhs_ai_publisher?useUnicode=true&characterEncoding=utf-8&sslMode=DISABLED&serverTimezone=Asia/Shanghai
spring.quartz.properties.org.quartz.dataSource.quartzDataSource.user=root
spring.quartz.properties.org.quartz.dataSource.quartzDataSource.password=your_db_password_here
spring.quartz.properties.org.quartz.dataSource.quartzDataSource.maxConnections=5

# 文件上传配置
spring.servlet.multipart.max-file-size=10MB
spring.servlet.multipart.max-request-size=10MB

# 安全配置
spring.security.user.name=admin
spring.security.user.password=your_secure_password_here
spring.security.user.roles=ADMIN

# AI模型配置
ai.model.default-type=kimi
ai.model.kimi.api-key=
ai.model.kimi.base-url=https://api.moonshot.cn/v1
ai.model.kimi.model=moonshot-v1-8k
ai.model.kimi.max-tokens=2000
ai.model.kimi.temperature=0.7
ai.model.kimi.timeout=30
ai.model.kimi.endpoint=
ai.model.qwen.api-key=
ai.model.qwen.base-url=https://dashscope.aliyuncs.com/api/v1
ai.model.qwen.model=qwen-turbo
ai.model.qwen.max-tokens=2000
ai.model.qwen.temperature=0.7
ai.model.qwen.timeout=30
ai.model.qwen.endpoint=
ai.model.openai.api-key=
ai.model.openai.base-url=https://api.openai.com/v1
ai.model.openai.model=gpt-3.5-turbo
ai.model.openai.max-tokens=2000
ai.model.openai.temperature=0.7
ai.model.openai.timeout=30
ai.model.openai.endpoint=
ai.model.volcengine.api-key=
ai.model.volcengine.base-url=https://ark.cn-beijing.volces.com/api/v3
ai.model.volcengine.model=doubao-pro-4k
ai.model.volcengine.max-tokens=2000
ai.model.volcengine.temperature=0.7
ai.model.volcengine.timeout=30
ai.model.volcengine.endpoint=

# 生图模型配置
ai.model.image.api-key=
ai.model.image.endpoint=
ai.model.image.model=dall-e-3
ai.model.image.timeout=30

# 工作流API配置
workflow.api.base-url=http://8.137.103.115:8081
workflow.api.workflow-id=7431484143153070132
workflow.api.connect-timeout=5
workflow.api.read-timeout=120
workflow.api.max-retries=3
workflow.api.retry-delay=2
workflow.api.enable-backup=true
workflow.api.user-agent=XhsAiPublisher/2.0